---
import Layout from "../layouts/Layout.astro";
import "leaflet/dist/leaflet.css";
---

<Layout>
  <h1 class="text-2xl">Carte des établissements</h1>
  <p>Clique sur un point pour afficher le nom de l’établissement.</p>

  <div
    id="map"
    role="region"
    aria-label="Carte interactive des établissements"
    style="height: 600px; width: 100%;"
  ></div>
</Layout>

<script>
  import L from "leaflet";
  import listeEtablissements from "../assets/listeEtablissements.json";

  const map = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution:
      '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  }).addTo(map);

  listeEtablissements.forEach((etablissement) => {
    const popup = document.createElement("p");
    popup.textContent = etablissement.name;

    L.circleMarker([etablissement.lat, etablissement.lon], {
      radius: 5,
      color: "#1d4ed8",
      weight: 1,
      fillColor: "#3b82f6",
      fillOpacity: 0.7,
    })
      .addTo(map)
      .bindPopup(popup);
  });
</script>